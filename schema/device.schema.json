{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaTek LK Device Map",
  "description": "Defines partition layout, execution levels, and mapped function symbols for a MediaTek Little Kernel container.",
  "type": "object",
  "required": [
    "device",
    "soc",
    "firmware_version",
    "stock_lk_sha256",
    "container_size",
    "subpartitions",
    "symbols"
  ],
  "properties": {
    "device": { "type": "string" },
    "manufacturer": { "type": "string" },
    "soc": { "type": "string" },
    "arch": { "type": "string", "enum": ["aarch64", "arm"] },
    "firmware_version": { "type": "string" },
    "stock_lk_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_tee_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_tee_a_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_tee_b_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_preloader_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_vendor_boot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_dtbo_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stock_base_dtb_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "container_size": { "type": "integer" },
    "tee_partitions": { "type": "object" },
    "subpartitions": {
      "type": "object",
      "required": ["lk", "bl2_ext", "aee", "dtb"],
      "properties": {
        "lk": {
          "type": "object",
          "required": ["offset", "size", "load_addr", "el"],
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "container_span": { "type": "string" },
            "load_addr": { "type": "string" },
            "el": { "type": "integer", "enum": [1, 2] }
          }
        },
        "bl2_ext": {
          "type": "object",
          "required": ["offset", "size", "load_addr", "el"],
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "container_span": { "type": "string" },
            "load_addr": { "type": "string" },
            "el": { "type": "integer", "enum": [3] }
          }
        },
        "aee": {
          "type": "object",
          "required": ["offset", "size", "load_addr", "el"],
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "container_span": { "type": "string" },
            "load_addr": { "type": "string" },
            "el": { "type": "integer", "enum": [1] }
          }
        },
        "dtb": {
          "type": "object",
          "required": ["offset", "size"],
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "container_span": { "type": "string" }
          }
        },
        "atf": {
          "type": "object",
          "required": ["offset", "size", "load_addr", "el"],
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "container_span": { "type": "string" },
            "load_addr": { "type": "string" },
            "el": { "type": "integer", "enum": [3] }
          }
        },
        "tee": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "container_span": { "type": "string" },
            "load_addr": { "type": "string" },
            "el": { "type": "integer", "enum": [1] }
          }
        },
        "preloader": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "offset": { "type": "string" },
            "size": { "type": "string" },
            "size_bytes": { "type": "integer" },
            "header_offset": { "type": "string" },
            "payload_offset": { "type": "string" },
            "payload_size": { "type": "string" },
            "sig_offset": { "type": "string" },
            "sig_size": { "type": "string" },
            "container_span": { "type": "string" },
            "load_addr": { "type": "string" },
            "el": { "type": "integer", "enum": [3] },
            "arch": { "type": "string", "enum": ["arm"] }
          }
        }
      }
    },
    "symbols": {
      "type": "object",
      "required": ["lk", "bl2_ext"],
      "properties": {
        "lk": {
          "type": "object",
          "description": "Symbol virtual addresses in LK (BL33)"
        },
        "bl2_ext": {
          "type": "object",
          "description": "Symbol virtual addresses in BL2_EXT (EL3)"
        },
        "aee": {
          "type": "object",
          "description": "Symbol virtual addresses in AEE"
        },
        "atf": {
          "type": "object",
          "description": "Symbol virtual/physical addresses in ARM Trusted Firmware (BL31, EL3)"
        },
        "preloader": {
          "type": "object",
          "description": "Symbol virtual addresses in MediaTek Preloader (BL2, AArch32 SRAM)"
        }
      }
    },
    "registers": {
      "type": "object",
      "description": "Physical MMIO register addresses for SoC peripherals"
    },
    "keycodes": {
      "type": "object",
      "description": "Hardware keycode IDs detected by detect_key"
    },
    "smc_services": {
      "type": "object",
      "description": "Catalog of MediaTek SiP SMC services registered in ATF BL31",
      "additionalProperties": {
        "type": "object",
        "required": ["fid32", "fid64", "addr", "desc"],
        "properties": {
          "fid32": { "type": "string" },
          "fid64": { "type": "string" },
          "addr": { "type": "string" },
          "desc": { "type": "string" }
        }
      }
    },
    "zero_regions": {
      "type": "object",
      "description": "Zero-filled alignment padding regions in executable segments for clean code placement"
    },
    "unallocated_flash": {
      "type": "object",
      "description": "Unallocated pure 0x00 flash space in container partition"
    },
    "hooks": {
      "type": "object",
      "description": "Catalog of safe hook sites across bootchain lifecycle"
    },
    "dead_code": {
      "type": "object",
      "description": "Hardware- or build-specific unreferenced code regions (caves) safe for in-situ payload placement"
    },
    "device_tree_pipeline": {
      "type": "object",
      "description": "MediaTek Device Tree Pipeline architecture across LK, DTBO, vendor_boot, and OS handoff"
    }
  }
}
