# atf_map.rz — Rizin Analysis Script for ARM Trusted Firmware (TF-A BL31)
# Target: ADVAN X1 (Firmware Baseline v5)
# Usage: rz -i atf_map.rz -m 0x0000000048200000 00_atf.bin

e asm.arch = arm
e asm.bits = 64
e asm.cpu = armv8.2-a
e io.va = true

# Verified ATF entry point and runtime service symbols
f sym.atf_entry                  = 0x0000000048200000
